    { "id": "d-comment", "type": "new_comment", "issue_id": "issue-d", "actor_type": "member", "actor_id": "alice", "read": false, "created_at": "2026-08-01T10:00:00", "snoozed_until": "2026-08-24T09:00:00", "details": { "comment_id": "c-d1" }},
