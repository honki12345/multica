  "cases": [
    { "name": "no filter: newest per issue, snoozed issue hidden, returned one counted from its return", "filters": {}, "expected": ["sys-quick", "d-comment", "a-status", "b-mention", "c-run", "f-app", "sys-paused"] },
    { "name": "type group", "filters": { "types": ["comment"] }, "expected": ["d-comment", "a-comment", "f-comment"] },
    { "name": "type group, is not", "filters": { "types": ["comment"], "negated": ["type"] }, "expected": ["sys-quick", "a-status", "b-mention", "c-run", "f-app", "sys-paused"] },
    { "name": "type OR within dimension", "filters": { "types": ["mention", "run"] }, "expected": ["b-mention", "c-run"] },
    { "name": "actor", "filters": { "actors": ["member:alice"] }, "expected": ["d-comment", "a-comment", "b-mention"] },
    { "name": "actor system bucket", "filters": { "actors": ["system"] }, "expected": ["sys-quick"] },
    { "name": "actor is not keeps unattributed rows", "filters": { "actors": ["member:alice"], "negated": ["actor"] }, "expected": ["sys-quick", "a-status", "c-run", "f-app", "b-assign", "sys-paused"] },
    { "name": "received today", "filters": { "received": "today" }, "expected": ["sys-quick", "a-status"] },
    { "name": "received last 7 days", "filters": { "received": "last_7_days" }, "expected": ["sys-quick", "a-status", "b-mention", "c-run", "f-app"] },
    { "name": "unread only reads the rendered row and keeps issue-less rows", "filters": { "unreadOnly": true }, "expected": ["sys-quick", "d-comment", "a-status", "b-mention", "f-app"] },
    { "name": "status OR, AND priority", "filters": { "statuses": ["todo", "done"], "priorities": ["high", "urgent"] }, "expected": ["a-status", "f-app"] },
    { "name": "priority is not drops issue-less rows", "filters": { "priorities": ["high"], "negated": ["priority"] }, "expected": ["d-comment", "b-mention", "c-run", "f-app"] },
    { "name": "priority none is a value", "filters": { "priorities": ["none"] }, "expected": ["c-run"] },
    { "name": "project", "filters": { "projects": ["p1"] }, "expected": ["d-comment", "a-status"] },
    { "name": "project none", "filters": { "projects": ["none"] }, "expected": ["b-mention"] },
    { "name": "project is not", "filters": { "projects": ["p1"], "negated": ["project"] }, "expected": ["b-mention", "c-run", "f-app"] },
    { "name": "assignee", "filters": { "assignees": ["agent:agent-1", "member:carol"] }, "expected": ["a-status", "c-run"] },
    { "name": "assignee none", "filters": { "assignees": ["none"] }, "expected": ["d-comment", "b-mention"] },
    { "name": "label", "filters": { "labels": ["ui"] }, "expected": ["a-status", "c-run"] },
    { "name": "label is not", "filters": { "labels": ["bug"], "negated": ["label"] }, "expected": ["d-comment", "b-mention", "c-run", "f-app"] },
    { "name": "due overdue or none", "filters": { "dueDates": ["overdue", "none"] }, "expected": ["d-comment", "b-mention", "f-app"] },
    { "name": "due this week", "filters": { "dueDates": ["this_week"] }, "expected": ["a-status", "c-run"] },
    { "name": "due today, is not", "filters": { "dueDates": ["today"], "negated": ["dueDate"] }, "expected": ["d-comment", "b-mention", "c-run", "f-app"] },
    { "name": "agent running", "filters": { "agent": "running" }, "active_issue_ids": ["issue-a", "issue-c"], "expected": ["a-status", "c-run"] },
    { "name": "agent idle", "filters": { "agent": "idle" }, "active_issue_ids": ["issue-a", "issue-c"], "expected": ["d-comment", "b-mention", "f-app"] },
    { "name": "unread mentions", "filters": { "unreadOnly": true, "types": ["mention"] }, "expected": ["b-mention"] },
    { "name": "sender picks the representative row, then issue dimensions apply to it", "filters": { "actors": ["member:alice"], "statuses": ["todo"] }, "expected": ["d-comment", "a-comment"] },
    { "name": "unread applies to the newest matching row, not the newest row", "filters": { "actors": ["member:alice"], "unreadOnly": true }, "expected": ["d-comment", "b-mention"] }
  ]
}
